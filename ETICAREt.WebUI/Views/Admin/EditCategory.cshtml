@model CategoryModel
@{
    ViewData["Title"] = "Kategori Düzenle";
}

<div class="container mt-4">
    <div class="row">
        <div class="col-md-8 offset-md-2">
            <div class="card shadow-sm">
                <div class="card-header bg-warning">
                    <h4 class="mb-0"><i class="fas fa-edit"></i> Kategori Düzenle</h4>
                </div>
                <div class="card-body">
                    <form asp-action="EditCategory" method="post">
                        <input type="hidden" asp-for="Id" />

                        <div class="mb-3">
                            <label asp-for="Name" class="form-label">Kategori Adı</label>
                            <input asp-for="Name" class="form-control">
                            <span asp-validation-for="Name" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Bu Kategorideki Ürünler</label>
                            @if (Model.Products != null && Model.Products.Any())
                            {
                                <div class="list-group">
                                    @foreach (var product in Model.Products)
                                    {
                                        <div class="list-group-item d-flex justify-content-between align-items-center">
                                            <div>
                                                <i class="fas fa-box text-primary"></i>
                                                <strong>@product.Name</strong>
                                                <br>
                                                <small class="text-muted">@product.Price.ToString("C2")</small>
                                            </div>
                                            <button type="button"
                                                    class="btn btn-sm btn-danger"
                                                    onclick="removeProductFromCategory(@Model.Id, @product.Id, '@product.Name')">
                                                <i class="fas fa-times"></i> Kaldır
                                            </button>
                                        </div>
                                    }
                                </div>
                            }
                            else
                            {
                                <div class="alert alert-info">
                                    <i class="fas fa-info-circle"></i> Bu kategoride ürün bulunmamaktadır.
                                </div>
                            }
                        </div>

                        <div class="d-grid gap-2 d-md-flex justify-content-md-end">
                            <a asp-action="CategoryList" class="btn btn-secondary">
                                <i class="fas fa-arrow-left"></i> Geri Dön
                            </a>
                            <button type="submit" class="btn btn-warning">
                                <i class="fas fa-save"></i> Güncelle
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

<form id="removeProductForm" asp-action="DeleteFromCategory" method="post" style="display:none;">
    <input type="hidden" name="categoryId" id="removeCategoryId" />
    <input type="hidden" name="productId" id="removeProductId" />
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
