@model CategoryListModel
@{
    ViewData["Title"] = "Kategori Yönetimi";
}

<div class="container-fluid mt-4">
    <div class="row mb-4">
        <div class="col-md-12">
            <div class="d-flex justify-content-between align-items-center">
                <h2><i class="fas fa-tags"></i> Kategori Yönetimi</h2>
                <a asp-action="CreateCategory" class="btn btn-success">
                    <i class="fas fa-plus"></i> Yeni Kategori Ekle
                </a>
            </div>
        </div>
    </div>

    <div class="card shadow-sm">
        <div class="card-body">
            @if (Model.Categories != null && Model.Categories.Any())
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle" id="categoriesTable">
                        <thead class="table-dark">
                            <tr>
                                <th>ID</th>
                                <th>Kategori Adı</th>
                                <th>Ürün Sayısı</th>
                                <th class="text-center">İşlemler</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var category in Model.Categories)
                            {
                                <tr>
                                    <td><strong>#@category.Id</strong></td>
                                    <td>
                                        <i class="fas fa-folder text-warning"></i> @category.Name
                                    </td>
                                    <td>
                                        @if (category.ProductCategories != null)
                                        {
                                            <span class="badge bg-info">@category.ProductCategories.Count Ürün</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">0 Ürün</span>
                                        }
                                    </td>
                                    <td class="text-center">
                                        <div class="btn-group" role="group">
                                            <a asp-action="EditCategory"
                                               asp-route-id="@category.Id"
                                               class="btn btn-sm btn-warning">
                                                <i class="fas fa-edit"></i> Düzenle
                                            </a>
                                            <button type="button"
                                                    class="btn btn-sm btn-danger"
                                                    onclick="deleteCategory(@category.Id, '@category.Name')">
                                                <i class="fas fa-trash"></i> Sil
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="alert alert-info text-center">
                    <i class="fas fa-info-circle"></i> Henüz kategori bulunmamaktadır.
                </div>
            }
        </div>
    </div>
</div>

<form id="deleteCategoryForm" asp-action="DeleteCategory" method="post" style="display:none;">
    <input type="hidden" name="categoryId" id="deleteCategoryId" />
</form>
