@model ProductListModel
@{
    ViewData["Title"] = "Ürün Yönetimi";
}

<div class="container-fluid mt-4">
    <div class="row mb-4">
        <div class="col-md-12">
            <div class="d-flex justify-content-between align-items-center">
                <h2><i class="fas fa-box"></i> Ürün Yönetimi</h2>
                <a asp-action="CreateProduct" class="btn btn-success">
                    <i class="fas fa-plus"></i> Yeni Ürün Ekle
                </a>
            </div>
        </div>
    </div>

    <div class="card shadow-sm">
        <div class="card-body">
            @if (Model.Products != null && Model.Products.Any())
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle" id="productsTable">
                        <thead class="table-dark">
                            <tr>
                                <th>Resim</th>
                                <th>Ürün Adı</th>
                                <th>Açıklama</th>
                                <th>Fiyat</th>
                                <th>Kategoriler</th>
                                <th class="text-center">İşlemler</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var product in Model.Products)
                            {
                                <tr>
                                    <td>
                                        @if (product.Images != null && product.Images.Any())
                                        {
                                            <img src="~/img/@product.Images.First().ImageUrl"
                                                 alt="@product.Name"
                                                 class="product-thumbnail">
                                        }
                                        else
                                        {
                                            <img src="~/img/no-image.png"
                                                 alt="No Image"
                                                 class="product-thumbnail">
                                        }
                                    </td>
                                    <td>
                                        <strong>@product.Name</strong>
                                    </td>
                                    <td>
                                        <span class="text-truncate d-inline-block" style="max-width: 300px;">
                                            @product.Description
                                        </span>
                                    </td>
                                    <td>
                                        <span class="badge bg-primary fs-6">@product.Price.ToString("C2")</span>
                                    </td>
                                    <td>
                                        @if (product.ProductCategories != null && product.ProductCategories.Any())
                                        {
                                            @foreach (var pc in product.ProductCategories)
                                            {
                                                <span class="badge bg-info text-dark me-1">@pc.Category.Name</span>
                                            }
                                        }
                                        else
                                        {
                                            <span class="text-muted">Kategori Yok</span>
                                        }
                                    </td>
                                    <td class="text-center">
                                        <div class="btn-group" role="group">
                                            <a asp-action="EditProduct"
                                               asp-route-id="@product.Id"
                                               class="btn btn-sm btn-warning">
                                                <i class="fas fa-edit"></i> Düzenle
                                            </a>
                                            <button type="button"
                                                    class="btn btn-sm btn-danger"
                                                    onclick="deleteProduct(@product.Id, '@product.Name')">
                                                <i class="fas fa-trash"></i> Sil
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="alert alert-info text-center">
                    <i class="fas fa-info-circle"></i> Henüz ürün bulunmamaktadır.
                </div>
            }
        </div>
    </div>
</div>

<form id="deleteForm" asp-action="DeleteProduct" method="post" style="display:none;">
    <input type="hidden" name="productId" id="deleteProductId" />
</form>
